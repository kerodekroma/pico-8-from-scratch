version 43
__lua__
function _init()
  _init_as()
end

function _update()
  _upd_as()
end

function _draw()
  cls()
  
  map(0,0,0,0)
  
  _draw_as()  
end
-->8
-- avatar selection scene

-- start the avatar selection screen
function _init_as()
 as_grid = {
  {nil,nil},
  {nil,nil},
 }
 as_cursor = {
  x=0,
  y=0,
  shape='cursor'
 }
 as_grid_min=0
 as_grid_max=1
 shapes = {'r','b','y','g'}
end

function _upd_as()
  -- using max because it 
 -- takes the max in a range
 if btnp(⬅️) then
	  as_cursor.x=max(as_grid_min,as_cursor.x-1)
 end
 -- using min because it 
 -- takes the min in a range
 if btnp(➡️) then
   as_cursor.x=min(as_grid_max,as_cursor.x+1)
 end

 -- using max because it 
 -- takes the max in a range
 if btnp(⬆️) then
	  as_cursor.y=max(as_grid_min,as_cursor.y-1)
 end
 -- using min because it 
 -- takes the min in a range
 if btnp(⬇️) then
   as_cursor.y=min(as_grid_max,as_cursor.y+1)
 end
end

function _draw_as()
 for i=1,#shapes do
  local shape_name = shapes[i]
  local odd = i%2==0 and true or false
  local shape_x = 38 
  local shape_y = i*16 + 16
  if odd then
    shape_x = 35*2
    shape_y = i*16
  end
  spr_shape(shape_name,shape_x,shape_y)
 end

 -- cursor 
 local x = 38 + as_cursor.x * 32
 local y = 32 + as_cursor.y * 32
 spr_shape(as_cursor.shape,x,y)
end
-->8

-- cursor
function _init_cursor()
 cursor_data = {
  x=0,
  y=0,
  shape='cursor'
 }
end

function _update_cursor()
 -- using max because it 
 -- takes the max in a range
 if btnp(⬅️) then
	  cursor_data.x=max(0,cursor_data.x-1)
 end
 -- using min because it 
 -- takes the min in a range
 if btnp(➡️) then
   cursor_data.x=min(2,cursor_data.x+1)
 end

 -- using max because it 
 -- takes the max in a range
 if btnp(⬆️) then
	  cursor_data.y=max(0,cursor_data.y-1)
 end
 -- using min because it 
 -- takes the min in a range
 if btnp(⬇️) then
   cursor_data.y=min(2,cursor_data.y+1)
 end
 
 
end

function _draw_cursor()
 -- spr(ball.frame, ball.x, ball.y)
 local x = 22 + cursor_data.x * 32
 local y = 24 + cursor_data.y * 32
 spr_shape(cursor_data.shape,x,y)
end
-->8
-- sprite render
spr_size = 8
function spr_shape(name, x, y)
 if name == 'cursor' then
   -- top-left
   spr(36, x+2, y)
   -- bottom-left
   spr(36, x+2, y+spr_size*2, 1, 1, false, true)
   -- top-right
   spr(36, x+spr_size*2+2, y, 1, 1, true, false)
   -- bottom-right
   spr(36, x+spr_size*2+2, y+spr_size*2, 1, 1, true, true) 
 end
 
 if name == 'r' then
   -- top-left
   spr(4, x+2, y)
   -- bottom-left
   spr(4, x+2, y+spr_size*2, 1, 1, false, true)
   -- top-right
   spr(4, x+spr_size*2+2, y, 1, 1, true, false)
   -- bottom-right
   spr(4, x+spr_size*2+2, y+spr_size*2, 1, 1, true, true) 
 end

 if name == 'b' then
   -- top-left
   spr(20, x+2, y)
   -- bottom-left
   spr(20, x+2, y+spr_size*2, 1, 1, false, true)
   -- top-right
   spr(20, x+spr_size*2+2, y, 1, 1, true, false)
   -- bottom-right
   spr(20, x+spr_size*2+2, y+spr_size*2, 1, 1, true, true) 
 end
 
 if name == 'y' then
   -- top-left
   spr(24, x+2, y)
   -- bottom-left
   spr(24, x+2, y+spr_size*2, 1, 1, false, true)
   -- top-right
   spr(24, x+spr_size*2+2, y, 1, 1, true, false)
   -- bottom-right
   spr(24, x+spr_size*2+2, y+spr_size*2, 1, 1, true, true) 
 end  

  if name == 'g' then
   -- top-left
   spr(8, x+2, y)
   -- bottom-left
   spr(8, x+2, y+spr_size*2, 1, 1, false, true)
   -- top-right
   spr(8, x+spr_size*2+2, y, 1, 1, true, false)
   -- bottom-right
   spr(8, x+spr_size*2+2, y+spr_size*2, 1, 1, true, true) 
 end  

end


